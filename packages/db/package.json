{
  "name": "@cogito-app/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:start": "docker compose up -d",
    "db:start:test": "docker compose -f docker-compose.test.yml up -d",
    "db:watch": "docker compose up",
    "db:watch:test": "docker compose -f docker-compose.test.yml up",
    "db:stop": "docker compose stop",
    "db:stop:test": "docker compose -f docker-compose.test.yml stop",
    "db:down": "docker compose down",
    "db:down:test": "docker compose -f docker-compose.test.yml down"
  },
  "dependencies": {
    "@cogito-app/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cogito-app/config": "workspace:*",
    "drizzle-kit": "^0.31.8",
    "typescript": "catalog:"
  }
}
