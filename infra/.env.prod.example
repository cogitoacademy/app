NODE_ENV=production
DATABASE_URL=postgresql://cogito:CHANGE_ME@postgres-prod:5432/cogito
REDIS_URL=redis://redis-prod:6379
BETTER_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
BETTER_AUTH_URL=https://cogitoacademy.id
CORS_ORIGIN=https://app.cogitoacademy.id
PORT=3001
# W4: required behind Caddy/Coolify — the reverse proxy terminates TLS and
# forwards x-forwarded-for. Without TRUST_PROXY=true, rate limiting and the
# webhook IP allowlist see Caddy's IP instead of the client's.
TRUST_PROXY=true
# P3: xendit provider against api-version 2024-11-11. The redirect URLs are
# required by the env schema (P3.7). Sandbox E2E first (RUNBOOK checklist).
PAYMENT_PROVIDER=xendit
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
XENDIT_SECRET_KEY=CHANGE_ME
XENDIT_WEBHOOK_TOKEN=CHANGE_ME
XENDIT_SUCCESS_REDIRECT_URL=https://app.cogitoacademy.id/balance
XENDIT_FAILURE_REDIRECT_URL=https://app.cogitoacademy.id/balance
SCHEDULER_ENABLED=true
# P4.1: RESEND_API_KEY is required in production (env schema fails otherwise).
# EMAIL_FROM must be a verified Resend sending address (not the dev default).
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=noreply@cogitoacademy.id
# P4.2: GOOGLE_MEET_ENABLED=true requires a complete credential set. Use the
# OAuth triple (GOOGLE_MEET_CLIENT_ID + GOOGLE_MEET_CLIENT_SECRET +
# GOOGLE_MEET_REFRESH_TOKEN) OR the service account (GOOGLE_CLIENT_EMAIL +
# GOOGLE_PRIVATE_KEY + GOOGLE_IMPERSONATED_USER — required: without domain-wide
# delegation events land on the SA's own calendar and never produce a Meet URL).
GOOGLE_CLIENT_EMAIL=CHANGE_ME@iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=CHANGE_ME
GOOGLE_CALENDAR_ID=primary
GOOGLE_IMPERSONATED_USER=CHANGE_ME@cogitoacademy.id
GOOGLE_MEET_ENABLED=true
GOOGLE_MEET_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_MEET_CLIENT_SECRET=CHANGE_ME
GOOGLE_MEET_REFRESH_TOKEN=CHANGE_ME
SESSION_COOKIE_CACHE_MAX_AGE=60
# Xendit webhook source IPs (documented in RUNBOOK) — comma-separated.
WEBHOOK_ALLOWED_IPS=CHANGE_ME_COMMA_SEPARATED
# P4.3: all four R2_* vars AND R2_PUBLIC_URL are required in production.
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=CHANGE_ME
R2_PUBLIC_URL=https://CHANGE_ME.r2.cloudflarestorage.com
SEED_ALLOWED_IN_PROD=false
DB_SSL_REJECT_UNAUTHORIZED=true
METRICS_TOKEN=CHANGE_ME
SENTRY_DSN=
SENTRY_ENVIRONMENT=production