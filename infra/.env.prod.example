# Production environment guide — the API resource env (applied by
# infra/ansible/coolify-resources.yml from the SOPS vault).
#
# This file documents every variable the production API needs, grouped by
# feature, with REQUIRED / OPTIONAL / MODE-SPECIFIC markers. The values
# themselves live in the SOPS-encrypted vault (infra/secrets/prod.env) — the
# operator fills that file, never this one.
#
# ── "Which mode am I?" decision tree ─────────────────────────────────────────
# Google Meet needs ONE of two credential sets. Decide before filling:
#
#   OAuth triple (recommended for a single operator mailbox):
#     GOOGLE_MEET_CLIENT_ID + GOOGLE_MEET_CLIENT_SECRET + GOOGLE_MEET_REFRESH_TOKEN
#     → leave GOOGLE_CLIENT_EMAIL / GOOGLE_PRIVATE_KEY / GOOGLE_IMPERSONATED_USER
#       EMPTY (they are service-account-only).
#
#   Service account (domain-wide delegation):
#     GOOGLE_CLIENT_EMAIL + GOOGLE_PRIVATE_KEY + GOOGLE_IMPERSONATED_USER
#     → leave the GOOGLE_MEET_* triple EMPTY.
#
# A partial set fails boot loudly (env schema). GOOGLE_MEET_ENABLED=true is
# required to activate either mode.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (REQUIRED) ─────────────────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=postgresql://cogito:CHANGE_ME@postgres-prod:5432/cogito
REDIS_URL=redis://redis-prod:6379
BETTER_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
BETTER_AUTH_URL=https://api.cogitoacademy.id
CORS_ORIGIN=https://app.cogitoacademy.id
PORT=3001
# REQUIRED behind the Traefik proxy — it terminates TLS and forwards
# x-forwarded-for. Without TRUST_PROXY=true, rate limiting and the webhook IP
# allowlist see the proxy's IP instead of the client's.
TRUST_PROXY=true
# Comma-separated trusted operator accounts promoted on production boot.
ADMIN_EMAILS=itcogitoacademy01@gmail.com
# Coolify's bundled PostgreSQL does not support TLS. Set true for a managed DB
# whose endpoint requires TLS.
DB_SSL_ENABLED=false
# Only applies when DB_SSL_ENABLED=true.
DB_SSL_REJECT_UNAUTHORIZED=true
# REQUIRED in production — a prod server without the scheduler silently skips
# booking expiry, hold release, email dispatch and SLA escalation.
SCHEDULER_ENABLED=true
SESSION_COOKIE_CACHE_MAX_AGE=60

# ── Auth (REQUIRED) ──────────────────────────────────────────────────────────
# Google OAuth sign-in (optional feature; omit GOOGLE_CLIENT_ID/SECRET to
# disable). When set, both are required.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ── Meet (MODE-SPECIFIC — see the decision tree above) ───────────────────────
GOOGLE_MEET_ENABLED=true
# OAuth triple (mode A):
GOOGLE_MEET_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_MEET_CLIENT_SECRET=CHANGE_ME
GOOGLE_MEET_REFRESH_TOKEN=CHANGE_ME
# Service account (mode B — service-account-only, leave empty in mode A):
GOOGLE_CLIENT_EMAIL=CHANGE_ME@iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=CHANGE_ME
# REQUIRED in service-account mode — without domain-wide delegation events
# land on the SA's own calendar and never produce a Meet URL.
GOOGLE_IMPERSONATED_USER=CHANGE_ME@cogitoacademy.id
GOOGLE_CALENDAR_ID=primary

# ── Payments (REQUIRED when PAYMENT_PROVIDER=xendit) ─────────────────────────
PAYMENT_PROVIDER=xendit
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
# Xendit selects Test/Live from the API key. Keep `test` while the production
# app is undergoing UAT; switch to `live` only after sandbox E2E and one real
# small transaction (RUNBOOK checklist).
XENDIT_MODE=test
XENDIT_SECRET_KEY=CHANGE_ME
XENDIT_WEBHOOK_TOKEN=CHANGE_ME
# REQUIRED in production-like envs while XENDIT_MODE=test — restricts sandbox
# purchases to explicit UAT accounts (comma-separated).
XENDIT_TEST_ALLOWED_EMAILS=qa@example.com
XENDIT_SUCCESS_REDIRECT_URL=https://app.cogitoacademy.id/balance
XENDIT_FAILURE_REDIRECT_URL=https://app.cogitoacademy.id/balance
XENDIT_DEFAULT_PAYMENT_METHOD=qris
# OPTIONAL (defense-in-depth only). Xendit publishes no stable webhook source
# IP list, so a wrong allowlist silently 403s webhooks and payments never
# credit — the x-callback-token signature is the primary gate. Leave empty to
# skip the IP check (2026-08-28 decision).
WEBHOOK_ALLOWED_IPS=

# --- Payments (Midtrans) — required when PAYMENT_PROVIDER=midtrans ---
# Midtrans selects Sandbox/Production from the API key; MIDTRANS_MODE is our
# explicit deployment assertion only. Cutover guide: docs/MIDTRANS-MIGRATION.md.
# The Xendit keys above stay in place as the rollback path (flip
# PAYMENT_PROVIDER back to xendit to roll back).
# MIDTRANS_MODE=test
# MIDTRANS_SERVER_KEY=SB-Mid-server-...
# MIDTRANS_CLIENT_KEY=SB-Mid-client-...
# MIDTRANS_MERCHANT_ID=G...
# OPTIONAL — defaults to MIDTRANS_SERVER_KEY when unset (Midtrans signs with
# the server key unless a separate webhook signature key is configured).
# MIDTRANS_WEBHOOK_SIGNATURE_KEY=

# ── Email (REQUIRED in production) ───────────────────────────────────────────
# REQUIRED — the env schema fails otherwise (the stub provider would silently
# suppress every critical email). EMAIL_FROM must be a verified Resend
# sending address (not the dev default).
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=noreply@cogitoacademy.id

# ── Storage (REQUIRED in production) ─────────────────────────────────────────
# All four R2_* vars AND R2_PUBLIC_URL are required together in production —
# without them uploads silently write to the container-local UPLOAD_DIR and
# are lost on every redeploy; without R2_PUBLIC_URL objects are unreachable.
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
# PUBLIC bucket for app uploads — served through the R2 custom domain
# (r2bucket.cogitoacademy.id). NEVER use this bucket for database backups.
R2_BUCKET=cogito-bucket
R2_PUBLIC_URL=https://r2bucket.cogitoacademy.id
# PRIVATE bucket for nightly backups + CD pre-migrate snapshots (API-token
# only, no public domain). Consumed by infra/backup.sh + migrate-and-deploy.sh.
R2_BACKUP_BUCKET=cogito-backups

# ── Content (Sanity — OPTIONAL; omit to disable editorial content) ───────────
SANITY_PROJECT_ID=CHANGE_ME
SANITY_DATASET=production
SANITY_API_VERSION=2024-03-01
SANITY_API_TOKEN=CHANGE_ME

# ── Ops (REQUIRED / OPTIONAL) ────────────────────────────────────────────────
METRICS_TOKEN=CHANGE_ME
SEED_ALLOWED_IN_PROD=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
