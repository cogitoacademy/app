NODE_ENV=staging
DATABASE_URL=postgresql://cogito_staging:CHANGE_ME@postgres-staging:5432/cogito_staging
REDIS_URL=redis://redis-staging:6379
BETTER_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
BETTER_AUTH_URL=https://staging.cogitoacademy.id
CORS_ORIGIN=https://staging-app.cogitoacademy.id
PORT=3001
# W4: required behind Caddy/Coolify — the reverse proxy terminates TLS and
# forwards x-forwarded-for. Without TRUST_PROXY=true, rate limiting and the
# webhook IP allowlist see Caddy's IP instead of the client's.
TRUST_PROXY=true
# Staging behaves like production for the fail-loud guards (Resend key, R2,
# SSL, cookies) but may keep the stub payment provider so the app boots with
# PAYMENT_PROVIDER=stub. Note: the stub checkout endpoint always returns 404
# in staging (stubCheckoutEnabled only allows development/test) — use real
# Xendit sandbox keys for any checkout E2E.
PAYMENT_PROVIDER=stub
STUB_WEBHOOK_ALLOWED=true
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
SCHEDULER_ENABLED=true
# P4.1: production/staging require the Resend API key — the stub email
# provider would silently suppress all emails. EMAIL_FROM must be a verified
# Resend sending address.
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=noreply@staging.cogitoacademy.id
# P4.2: GOOGLE_MEET_ENABLED=true requires a complete credential set — the OAuth
# triple (GOOGLE_MEET_CLIENT_ID + GOOGLE_MEET_CLIENT_SECRET +
# GOOGLE_MEET_REFRESH_TOKEN) OR the service account
# (GOOGLE_CLIENT_EMAIL + GOOGLE_PRIVATE_KEY + GOOGLE_IMPERSONATED_USER).
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATED_USER=
GOOGLE_CALENDAR_ID=primary
GOOGLE_MEET_ENABLED=false
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=
# Comma-separated trusted operator accounts promoted on staging boot.
ADMIN_EMAILS=itcogitoacademy01@gmail.com
# P4.3: production/staging require all R2_* vars + R2_PUBLIC_URL. Staging can
# keep local-disk uploads (UPLOAD_DIR) while all R2 vars stay empty.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Webhook source IP allowlist (comma-separated). Xendit webhook IPs documented
# in RUNBOOK.
WEBHOOK_ALLOWED_IPS=
SESSION_COOKIE_CACHE_MAX_AGE=60
# Coolify's bundled PostgreSQL does not support TLS. Set true for a managed DB
# whose endpoint requires TLS.
DB_SSL_ENABLED=false
# Only applies when DB_SSL_ENABLED=true.
DB_SSL_REJECT_UNAUTHORIZED=true
METRICS_TOKEN=CHANGE_ME
