// config.alloy — Grafana Alloy log shipper (source of truth in git).
//
// Declared by infra/ansible/observability.yml (inside the `cogito-alloy`
// bundle alongside node_exporter + cAdvisor). Ships container logs to Loki.
//
// A3 HARD REQUIREMENT: Docker API discovery ONLY
// (`discovery.docker` + `loki.source.docker`, socket mounted read-only).
// NEVER file globs under /var/lib/docker (brittle across Docker storage
// drivers and Coolify upgrades). No `local.file_match` / `loki.source.file`
// component may be added to this file.
//
// Log privacy: labels carry the container/service name + traceId/userId
// from the log line. Emitters never log email; this shipper adds no PII.

discovery.docker "cogito" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "cogito" {
  targets = discovery.docker.cogito.targets

  // `service` = the stable Coolify resource name (cogito-api, cogito-web,
  // cogito-grafana, ...) when present: it survives redeploys unchanged and
  // is exactly what the dashboards and ops.sh trace query. Parsing the
  // container name does NOT work — Coolify names are random per resource
  // (e.g. /6ophpbzmsblhvetxi47gqd7e-123025570652) with alphanumeric redeploy
  // suffixes, so suffix-stripping yields unstable garbage like
  // `service="grafana-jl9rheh7fv6mz5zshme1z7jw"` that matches no dashboard
  // query (the live No-Data root cause, 2026-09-06).
  rule {
    source_labels = ["__meta_docker_container_label_coolify_resourceName"]
    regex         = "(.+)"
    replacement   = "$1"
    target_label  = "service"
  }

  // Fallback for non-Coolify containers (coolify-sentinel, …): stripped
  // container name. Applies ONLY when the rule above left `service` empty
  // (the `^;` anchor fails otherwise), so it can never clobber a real name.
  rule {
    source_labels = ["service", "__meta_docker_container_name"]
    separator     = ";"
    regex         = "^;/(.*?)(-[0-9]+)?$"
    replacement   = "$1"
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__address__"]
    regex         = "(.*)"
    replacement   = "docker"
    target_label  = "job"
  }
}

loki.source.docker "default" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.relabel.cogito.output

  forward_to = [loki.write.cogito.receiver]
}

loki.write "cogito" {
  endpoint {
    // Shared `cogito-obs` Docker network (one-time `docker network create`,
    // declared external in every obs compose): `loki` is the Compose
    // service-name alias on that network. Each Coolify service otherwise
    // gets its OWN isolated network, so bare service names do NOT resolve
    // without the shared net (verified live 2026-09-05). Loopback-published
    // :3100 remains for tunnels/debugging; nothing is public.
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Backup log ship (2026-09-07): tails the host-mounted single file
// /var/log/cogito-backup.log (read-only bind-mount declared in the
// cogito-alloy compose in observability.yml). A3-compliant: this path is
// outside /var/lib/docker (no Docker storage-driver globs); Docker-API
// discovery above is untouched.
loki.source.file "backup" {
  targets = [
    { __path__ = "/var/log/cogito-backup.log", service = "cogito-backup", job = "backup" },
  ]

  forward_to = [loki.write.cogito.receiver]
}
