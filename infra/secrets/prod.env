DATABASE_URL=ENC[AES256_GCM,data:2f846vgNRocYBoBUWtP/ww0EM1l7UnQ9QB7bA9QMGKUppatkVXEoJ93Kr08bqINm2fg0sMagSUPHws5POV+7TE95ctbbV7T/4OS7dn4BQTY+CrfcxlGfr932TUrRyYeoNsFHHOfhaWVfXz35Bewa7/rdo8h2ut33qPI8,iv:5A3fc7+tLAH3LxU/KjjMcqCZlrVF9rgTZSxvrlS5KaI=,tag:4ex5KVZJbiL/HPgC7qp86g==,type:str]
REDIS_URL=ENC[AES256_GCM,data:bAQbfoTJjEZOWM8BhUa/ZN3xW62qDeiojP0pbBuU6m5+I2C7oMNYQCR17cfg0z7POyoIR+W6GlHxtdjLPV6ZI4uqJaF4f9tV97pGr3JSBSKJbMgwMKSufsTd1UzGyFGhr61hZ1BoxQUHZFf4YRMw5w==,iv:Fl+6xmYV91QPt8DsFDLXzouZYRvQQvqVTd9I43nfVe8=,tag:pe6IuNg5OKzycjDBR756Ug==,type:str]
# Ops-only (never applied to the app env; used by the playbooks / CD):
COOLIFY_API_TOKEN=ENC[AES256_GCM,data:uetyaQB/7jU0VJdufcvaaMfCSNLzOGA8UfHkbMnwgKVXoj4BBbdRKVPRMdQXe7XOE1A=,iv:8pkfzPtj4Mp7Wws2y5nYRrG5/+sH0MWHXqW/dsntnqc=,tag:m/oQUZ+dsOvbR9Mvq4IyzA==,type:str]
TS_AUTH_KEY=ENC[AES256_GCM,data:RXU8K3cNSLsz4Y28Y1VtLpjCNBdTJFhXxOZvUuxwfCfJQd7SGDUyJtNTCWk5L54v93H/n9IKdq1ZvbgbBk8=,iv:9EFaCQLvL7gu1ySTxW11w26pdYMbYlOdGm2tSqnoRBc=,tag:ley+JKBCO4x5v1ncukxAXg==,type:str]
# --- Email (Resend) — REQUIRED in production ---
RESEND_API_KEY=ENC[AES256_GCM,data:xSVXEAwLRzJvlEy4AoVNqR0DgTmxrpOINo5Uwf5jfZdohzSy,iv:LXJ6skO+i7alDOMhEaxRZ9c+RqwEsIV3fdf4X6VQL3o=,tag:sxvTCmMjmYTooOsy+zMWHg==,type:str]
EMAIL_FROM=Cogito <send@cogitoacademy.id>
# --- Payments (Xendit) — REQUIRED when PAYMENT_PROVIDER=xendit ---
# Xendit selects Test/Live from the API key. Use `test` + Test Mode
# credentials during production-domain UAT; change to `live` only after go-live.
XENDIT_MODE=test
XENDIT_SECRET_KEY=ENC[AES256_GCM,data:laHHZS0udhK2CXR+airnVifu6ER93p+6IdXLhmmFotkzsiocSxApqKujmqM7KjDBq7xnSjL6f61SoQFgWoQudqopxTR6QeHMl5osICCv,iv:Z9yEK2Yfm3sLlKI3nnNWohVb0g55NaJrMTrt3Zp/1Po=,tag:xkte8pOCekojGebYxV/Q4g==,type:str]
XENDIT_WEBHOOK_TOKEN=ENC[AES256_GCM,data:geM+TuwwjvOsNvQYpULxlvpTHr9Mlosnxo4g+JMxj/LMSTWo+GRhhkTgdpk2NLCA,iv:3BJFDT+nMjB2bxXP75Ty/6CA7PNVeuPqzJj2lNctdYQ=,tag:d+2Vqb8pSWKXGRXy+3/2XA==,type:str]
# REQUIRED in production-like envs while XENDIT_MODE=test — restricts sandbox
# purchases to explicit UAT accounts (comma-separated).
PAYMENT_PROVIDER=xendit
XENDIT_TEST_ALLOWED_EMAILS=ENC[AES256_GCM,data:8lc/F/eUm8vw4ghSpw5HNQZm7PVI1dbRZtxs,iv:73KnI9x8ev2raTgaDyVnI6kl8XNzRtOy+pv+oqo4vh4=,tag:IkxxNLxjK6dpV2I7y/FmeA==,type:str]
XENDIT_SUCCESS_REDIRECT_URL=https://app.cogitoacademy.id/balance
XENDIT_FAILURE_REDIRECT_URL=https://app.cogitoacademy.id/balance
# OPTIONAL (defense-in-depth only). Xendit publishes no stable webhook source
# IP list — a wrong allowlist silently 403s webhooks and payments never
# credit; the x-callback-token signature is the primary gate (2026-08-28).
WEBHOOK_ALLOWED_IPS=
# --- Google OAuth (Auth) — OPTIONAL; both required when set ---
GOOGLE_CLIENT_ID=ENC[AES256_GCM,data:6nQJ2VMbeai/hkkidPdBTdtHdjVkJMPwNxHy7SKKz6yWC2tkpAMwK+SfcTlt109/5YvewWyTWJWqI3D0B207TWFN1EuV1vQH,iv:amdWlj2qRRZUiMRXanfIEGgJ0J/cx+blRddVcrocBKs=,tag:Sbi/1LnMKkSCucsC+6xcog==,type:str]
