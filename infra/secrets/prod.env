# --- Google Meet — MODE-SPECIFIC (see decision tree above) ---
GOOGLE_MEET_ENABLED=true
# OAuth triple (mode A):
GOOGLE_MEET_CLIENT_ID=ENC[AES256_GCM,data:xbe5nz/93BeiTWjZkZyS/m/kCEA/k0EpCmOe8HvgZx4qzZQTK904wCpqofMZ+63UWlVqJRy8LI0bVipsm6nukLyZRfRLOQBf,iv:EEGGjaA0Rb6NJ82QSISKezmYuss2sfc9KoO/OqzlhCg=,tag:fvzIxfLTNndnWaGucuxdug==,type:str]
