# --- Payments (Xendit) — REQUIRED when PAYMENT_PROVIDER=xendit ---
# Xendit selects Test/Live from the API key. Use `test` + Test Mode
# credentials during production-domain UAT; change to `live` only after go-live.
XENDIT_MODE=test
XENDIT_SECRET_KEY=ENC[AES256_GCM,data:y5h95j8xTtNj7iXO9T8rKS4U02wJIwrWln4zynoVl8LTpgGlsSeG+xBZunqDNFnjinZZpOhaKhIh5F0uDMolhhiga0anXr9YWDyz/eeWgQ==,iv:b2DcGN8JCi84hfmVLTaZCEZfUZVNhBgf+l38t2ANkLs=,tag:FOJuQQb5jj0c0xM9pWTGyg==,type:str]
