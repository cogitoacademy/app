# --- Payments (Xendit) — REQUIRED when PAYMENT_PROVIDER=xendit ---
# Xendit selects Test/Live from the API key. Use `test` + Test Mode
# credentials during production-domain UAT; change to `live` only after go-live.
XENDIT_MODE=test
XENDIT_SECRET_KEY=ENC[AES256_GCM,data:cHQg0BSWyATQM3ZcRyIdpj6h34wj8jIz7GQU57yUqZfIs8ry8nI8psBP0CUUxJOJKxfBWeJoK6INHwwNoa4S0pxQ1aAMXqiCeBcJNaT1wg==,iv:4f0I9gk/0mJXv/AenYLz05l/PrEv0TomTF1nTMQIk/g=,tag:RS5l6bEQSEbBDlFPVUvKqg==,type:str]
