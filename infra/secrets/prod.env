REDIS_URL=ENC[AES256_GCM,data:lxoE/QFRnY1g48vzr4ua8GmzgRz5OOrkOgJqjRGe3zeZfc4qi7F6eHvWTxr2R7bhGo31ExnARIjX6Mec/sqPxOGHE11DaHfvQlDBinxzopb5DPYwbIRckjORL+X3gZ3kGLHvbLkbp71coz5Z+cnDBw==,iv:wVrsFYlALcIikLORGFJMy5wbYkrB44UVPXhPmCjBxD8=,tag:8vTxF1TGiUz3VezmDCqm/w==,type:str]
# Ops-only (never applied to the app env; used by the playbooks / CD):
