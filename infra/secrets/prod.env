# Ops-only (never applied to the app env; used by the playbooks / CD):
COOLIFY_API_TOKEN=1|pUdnIuxolaYIYiGxEqaGvSyysOMW0nW5bQJsAopA74febb3f
TS_AUTH_KEY=ENC[AES256_GCM,data:yJZhSQ7dP6/NDEzSgPQiFzClCow2JJAH7lSGa7NYa9lR+kXqj6Ws1cH2vfIyMPLlhWmjOCDniR6U096smys=,iv:qFPoo3SG11RTiYQ1pPCxMLovx0H6LP8u3Ow71kq2OGw=,tag:KeP0DQpB9soykmSrsVgW/w==,type:str]
# --- Email (Resend) — REQUIRED in production ---
RESEND_API_KEY=ENC[AES256_GCM,data:lcdcxqpXy3LbXokWVkLdU54Yu9ipMj34+4pPEtbRGNGlpSAS,iv:mfTRoavqH9MgXZ5qRYCtecUwiSsqK8dd0XCCjmOET/M=,tag:CM72DfHohyo4KLvfv/YzJA==,type:str]
EMAIL_FROM=Cogito <send@cogitoacademy.id>
# --- Payments (Xendit) — REQUIRED when PAYMENT_PROVIDER=xendit ---
# Xendit selects Test/Live from the API key. Use `test` + Test Mode
# credentials during production-domain UAT; change to `live` only after go-live.
XENDIT_MODE=test
XENDIT_SECRET_KEY=ENC[AES256_GCM,data:vVZT3rEnbSXSNH5KzpivnKP7+gnvI4jnFzkyKiDnyxjKEizEr3B/duyxiC1EGCfiIyur+iAcWVUrVCA4KCGxXRLXsNIguqVpqpkUH5Gs,iv:UroVkN6mNdbCqC+aB2y+c4vQV/YzQT1kouEv8wC+GOk=,tag:+xn18kysQijUN5jw0PFWjw==,type:str]
XENDIT_WEBHOOK_TOKEN=ENC[AES256_GCM,data:+AmglHTt1KlisuFGr2UTgHBSU9igZ07OmHaBiXwlm+AfVWWI6wArEmVtfX9xZHYH,iv:QkrRu/Wl2rz/ETpjbwFnNOCrtCH2RJ5NJOUBSmxp1tA=,tag:XbmY9po3ckcMfkx67FoKrw==,type:str]
# REQUIRED in production-like envs while XENDIT_MODE=test — restricts sandbox
# purchases to explicit UAT accounts (comma-separated).
PAYMENT_PROVIDER=xendit
XENDIT_TEST_ALLOWED_EMAILS=itcogitoacademy01@gmail.com
XENDIT_SUCCESS_REDIRECT_URL=https://app.cogitoacademy.id/balance
XENDIT_FAILURE_REDIRECT_URL=https://app.cogitoacademy.id/balance
# OPTIONAL (defense-in-depth only). Xendit publishes no stable webhook source
# IP list — a wrong allowlist silently 403s webhooks and payments never
# credit; the x-callback-token signature is the primary gate (2026-08-28).
WEBHOOK_ALLOWED_IPS=
