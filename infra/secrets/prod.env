DATABASE_URL=ENC[AES256_GCM,data:bWwW3aHVeZvuf8l15cQO+qBnB3EzfJg6OjG968w6RY/TDTfWGDBRMz/ar6ZHk4xhAUWs/ZqFVtZThuYT7mnZ/COPUKWOlxOKrPQr97KUPgX4b/LaQkmF2Hd4z2lRvbCOzClVlq0CYQrwun20FBnPZasBuqdeCgJgxOIw,iv:uHDU33nL262oCHGv+JFe1IskjlbKWRHw4jHEAgjzdjI=,tag:bb3jMV3HGTLccKY2qiV2ow==,type:str]
REDIS_URL=ENC[AES256_GCM,data:GDqLbpp/H0uSYFRIe285/R5dWVCd07Dp5yyJ8DeRR2EaG+jOKVChx+iHJWGUZso34sI5pd6F4iIzoVdLRjo9yuQf6GtHL6uY1P4OUQzjV8ldvyb1fzcZ/6N+K8/nypGPXp9JCmrsldFn5Yl/L0gcxA==,iv:/lSwTH1szTKVPslaY60ivkQrpARF1Q+1uv/HEjkT+/Q=,tag:pRqIkwTvGzdjXtm1DDZ6Yw==,type:str]
# Ops-only (never applied to the app env; used by the playbooks / CD):
COOLIFY_API_TOKEN=ENC[AES256_GCM,data:ewPRcGWqDHGStThhJh6WEAB2sNtXX32BdVROJ+V63aefH2a1IeoiX7zGKM/f3JdqX3U=,iv:M6l8tgIwpekY/ge6QdyLxj+eRJEDcYYe/mDADzp6yLM=,tag:ikBXycxZBMjjPq8FEK5+FQ==,type:str]
