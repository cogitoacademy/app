# Production secrets — SOPS-encrypted. Fill values, then:
#   sops -e -i infra/secrets/prod.env    # encrypt in place
# Never commit the plaintext file.
#
# The operator fills these (the lead never types secrets). Values come from
# the accounts listed in docs/DEPLOYMENT.md → Resource access map.

# --- Core ---
BETTER_AUTH_SECRET=
PAYMENT_WEBHOOK_SECRET=
ADMIN_EMAILS=itcogitoacademy01@gmail.com

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@cogitoacademy.id

# --- Payments (Xendit) ---
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_SUCCESS_REDIRECT_URL=https://app.cogitoacademy.id/balance
XENDIT_FAILURE_REDIRECT_URL=https://app.cogitoacademy.id/balance
WEBHOOK_ALLOWED_IPS=

# --- Google OAuth + Meet ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=

# --- Storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cogito-backups
R2_PUBLIC_URL=

# --- Sanity ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-03-01
SANITY_API_TOKEN=

# --- Ops ---
METRICS_TOKEN=
TS_AUTH_KEY=

# --- Database / Redis (existing Coolify containers) ---
DATABASE_URL=postgresql://cogito:CHANGE_ME@postgres-prod:5432/cogito
REDIS_URL=redis://redis-prod:6379
