# Production secrets — SOPS-encrypted. The ENCRYPTED file is committed to git
# (the standard SOPS pattern); the PLAINTEXT file is gitignored and a
# pre-commit hook blocks accidental plaintext commits.
#
# First-time fill (from this template):
#   cp infra/secrets/prod.env.example infra/secrets/prod.env
#   # fill the values below (plaintext is fine on disk — it's gitignored)
#   sops -e -i infra/secrets/prod.env        # encrypt in place
#   sops -d infra/secrets/prod.env | grep -c "="   # verify (~44 keys)
#   git add -f infra/secrets/prod.env        # commit the ENCRYPTED file
#
# Later edits — NEVER re-encrypt from scratch, never keep a plaintext copy:
#   sops infra/secrets/prod.env              # in-memory decrypt → $EDITOR → re-encrypt
#   sops set infra/secrets/prod.env '["KEY"]' "value"   # single-key edit
#
# The operator fills the values (the lead never types secrets). Values come
# from the accounts listed in docs/DEPLOYMENT.md → Resource access map.
#
# ── "Which mode am I?" decision tree ─────────────────────────────────────────
# Google Meet needs ONE of two credential sets. Decide before filling:
#
#   OAuth triple (recommended for a single operator mailbox):
#     GOOGLE_MEET_CLIENT_ID + GOOGLE_MEET_CLIENT_SECRET + GOOGLE_MEET_REFRESH_TOKEN
#     → leave GOOGLE_CLIENT_EMAIL / GOOGLE_PRIVATE_KEY / GOOGLE_IMPERSONATED_USER
#       EMPTY (they are service-account-only).
#
#   Service account (domain-wide delegation):
#     GOOGLE_CLIENT_EMAIL + GOOGLE_PRIVATE_KEY + GOOGLE_IMPERSONATED_USER
#     → leave the GOOGLE_MEET_* triple EMPTY.
#
# A partial set fails boot loudly (env schema). GOOGLE_MEET_ENABLED=true is
# required to activate either mode.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core (REQUIRED) ---
BETTER_AUTH_SECRET=
PAYMENT_WEBHOOK_SECRET=
ADMIN_EMAILS=itcogitoacademy01@gmail.com
DATABASE_URL=postgresql://cogito:CHANGE_ME@postgres-prod:5432/cogito
REDIS_URL=redis://redis-prod:6379
# Ops-only (never applied to the app env; used by the playbooks / CD):
COOLIFY_API_TOKEN=
TS_AUTH_KEY=

# --- App constants (CONSTANT — no fill needed, copy as-is) ---
# The playbook pushes these to the Coolify API resource verbatim.
NODE_ENV=production
BETTER_AUTH_URL=https://api.cogitoacademy.id
CORS_ORIGIN=https://app.cogitoacademy.id
PORT=3001
TRUST_PROXY=true
DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=true
SCHEDULER_ENABLED=true
SESSION_COOKIE_CACHE_MAX_AGE=60
SEED_ALLOWED_IN_PROD=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Email (Resend) — REQUIRED in production ---
RESEND_API_KEY=
EMAIL_FROM=noreply@cogitoacademy.id

# --- Payments (Xendit) — REQUIRED when PAYMENT_PROVIDER=xendit ---
# Xendit selects Test/Live from the API key. Use `test` + Test Mode
# credentials during production-domain UAT; change to `live` only after go-live.
# CONSTANT: PAYMENT_PROVIDER=xendit (copy as-is).
PAYMENT_PROVIDER=xendit
XENDIT_MODE=test
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# REQUIRED in production-like envs while XENDIT_MODE=test — restricts sandbox
# purchases to explicit UAT accounts (comma-separated).
XENDIT_TEST_ALLOWED_EMAILS=qa@example.com
XENDIT_SUCCESS_REDIRECT_URL=https://app.cogitoacademy.id/balance
XENDIT_FAILURE_REDIRECT_URL=https://app.cogitoacademy.id/balance
XENDIT_DEFAULT_PAYMENT_METHOD=qris
# OPTIONAL (defense-in-depth only). Xendit publishes no stable webhook source
# IP list — a wrong allowlist silently 403s webhooks and payments never
# credit; the x-callback-token signature is the primary gate (2026-08-28).
WEBHOOK_ALLOWED_IPS=

# --- Google OAuth (Auth) — OPTIONAL; both required when set ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Meet — MODE-SPECIFIC (see decision tree above) ---
GOOGLE_MEET_ENABLED=true
# OAuth triple (mode A):
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=
# Service account (mode B — service-account-only, leave empty in mode A):
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATED_USER=
# CONSTANT (no fill needed) — `primary` = the OAuth account's main calendar.
GOOGLE_CALENDAR_ID=primary

# --- Storage (Cloudflare R2) — REQUIRED in production ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# PUBLIC bucket for app uploads (served via the R2 custom domain). NEVER put
# database backups here — they must not be reachable via a public URL.
R2_BUCKET=cogito-bucket
R2_PUBLIC_URL=https://r2bucket.cogitoacademy.id
# PRIVATE bucket for nightly backups + CD pre-migrate snapshots (API-token
# access only, no public domain). The backup cron + migrate-and-deploy.sh use
# this; keep it distinct from R2_BUCKET above.
R2_BACKUP_BUCKET=cogito-backups

# --- Content (Sanity) — OPTIONAL; omit to disable editorial content ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-03-01
SANITY_API_TOKEN=

# --- Ops ---
METRICS_TOKEN=
