# Base URL of the Cogito API (rpc/auth/health endpoints).
# - Absolute URL: http://localhost:3001 (local dev)
# - Same-origin relative path: /rpc (production — Caddy routes app.cogitoacademy.id/rpc/* to the server)
# Optional: when unset, dev defaults to http://localhost:3001 and production builds default to /rpc.
VITE_SERVER_URL=http://localhost:3001
