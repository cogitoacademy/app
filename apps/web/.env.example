# Base URL of the Cogito API (rpc/auth/health endpoints).
# - Absolute URL: http://localhost:3001 (local dev)
# - Absolute URL: https://api.cogitoacademy.id (production)
# A relative path such as /rpc is supported only when the reverse proxy for
# the frontend explicitly routes that path to the API.
# Optional: when unset, dev defaults to http://localhost:3001 and production
# builds default to https://api.cogitoacademy.id.
VITE_SERVER_URL=http://localhost:3001

# PostHog browser analytics (public project token and client API host).
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=<ph_project_token>
VITE_PUBLIC_POSTHOG_HOST=<ph_client_api_host>
