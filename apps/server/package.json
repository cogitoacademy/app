{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsgo -b --checkers 1",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "seed": "bun run src/seed/seed.ts",
    "seed-sanity-content": "bun --env-file .env ../../migration/sanity-content/import.ts",
    "seed-sanity-content:apply": "bun src/seed/seed.ts --sanity-content",
    "seed-invite": "bun run src/seed/seed-invite.ts"
  },
  "dependencies": {
    "@cogito-app/api": "workspace:*",
    "@cogito-app/auth": "workspace:*",
    "@cogito-app/db": "workspace:*",
    "@cogito-app/env": "workspace:*",
    "@elysiajs/cors": "^1.4.1",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:",
    "evlog": "^2.25.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cogito-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
