# Database
DATABASE_URL=postgresql://postgres:password@localhost:6767/cogito-app

# Server
PORT=3001

# Better Auth (secret must be at least 32 characters)
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3001

# CORS (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Payment
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=replace-with-a-secret-at-least-32-chars-long

# External links
COMPETITION_CALENDAR_URL=https://cogitoacademy.id/en/calendar
KNOWLEDGE_BANK_URL=https://cogitoacademy.id/knowledge-bank

# Environment
NODE_ENV=development

# Google OAuth (optional - leave blank to disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Meet auto-generation (optional)
GOOGLE_MEET_ENABLED=false
GOOGLE_CALENDAR_ID=primary

# Use this for normal Google/Gmail accounts. If empty, GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET are used for the Meet OAuth client too.
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=

# Use this only for Google Workspace service-account setups.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATED_USER=
