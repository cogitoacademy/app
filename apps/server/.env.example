# Database
DATABASE_URL=postgresql://postgres:password@localhost:6767/cogito-test
# Coolify's bundled PostgreSQL is private and does not serve TLS. Set true for
# a managed/external PostgreSQL endpoint that requires TLS.
DB_SSL_ENABLED=false
# Only applies when DB_SSL_ENABLED=true.
DB_SSL_REJECT_UNAUTHORIZED=true

# Server
PORT=3001

# Better Auth (secret must be at least 32 characters)
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3001

# CORS (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Production deployment uses separate API and frontend subdomains:
# BETTER_AUTH_URL=https://api.cogitoacademy.id
# CORS_ORIGIN=https://app.cogitoacademy.id

# Payment
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=replace-with-a-secret-at-least-32-chars-long
# To exercise Xendit without real money, use a Test Mode API key and set:
# PAYMENT_PROVIDER=xendit
# XENDIT_MODE=test
# XENDIT_SECRET_KEY=your-test-mode-secret-key
# XENDIT_WEBHOOK_TOKEN=your-test-mode-callback-token
# XENDIT_TEST_ALLOWED_EMAILS=your-verified-test-account@example.com
# XENDIT_SUCCESS_REDIRECT_URL=http://localhost:3000/balance
# XENDIT_FAILURE_REDIRECT_URL=http://localhost:3000/balance

# Webhooks
# Comma-separated IP allowlist for payment webhooks (e.g. 1.2.3.4,5.6.7.8). Leave
# empty to allow webhooks from any IP.
WEBHOOK_ALLOWED_IPS=
# Allow the authless stub checkout route (dev/test only; requires NODE_ENV != production).
STUB_WEBHOOK_ALLOWED=false
# Trust X-Forwarded-For for client IPs (set true only when behind a trusted reverse proxy).
TRUST_PROXY=false

# Seeding
# Allow running the seed script in production (dangerous - keep false in prod).
SEED_ALLOWED_IN_PROD=false
# Admin password used by the seed script (min 12 chars).
SEED_ADMIN_PASSWORD=
# Comma-separated production/staging admin bootstrap emails. The default
# operator account is promoted automatically; include additional trusted
# accounts here when they must be bootstrapped on signup or server boot.
ADMIN_EMAILS=itcogitoacademy01@gmail.com

# Redis (BullMQ queues, rate limits, idempotency)
REDIS_URL=redis://localhost:6379

# File uploads (Cloudflare R2)
# When all R2_* credentials are set, uploads use R2; otherwise a local uploads
# directory (UPLOAD_DIR) is used and served from /uploads/*.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: public base URL for R2 objects (e.g. https://cdn.example.com). When
# unset, files are served through the app's /uploads/* route instead.
R2_PUBLIC_URL=
# Local upload directory (used when R2 is not configured).
UPLOAD_DIR=./uploads

# Sanity content source (server-side only)
SANITY_PROJECT_ID=skfmwuke
SANITY_DATASET=development
SANITY_API_VERSION=2024-03-01
# Optional token for private Sanity datasets. Never expose this to the frontend.
SANITY_API_TOKEN=

# Environment
NODE_ENV=development

# Google OAuth (optional - leave blank to disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Meet auto-generation (optional). Full setup:
# docs/GOOGLE-MEET-SETUP.md
GOOGLE_MEET_ENABLED=false
GOOGLE_CALENDAR_ID=primary

# Use this for normal Google/Gmail accounts. If empty, GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET are used for the Meet OAuth client too.
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=

# Use this only for Google Workspace service-account setups.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATED_USER=
