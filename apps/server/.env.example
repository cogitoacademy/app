# Database
DATABASE_URL=postgresql://postgres:password@localhost:6767/cogito-app

# Server
PORT=3001

# Better Auth (secret must be at least 32 characters)
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3001

# CORS (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Payment
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=replace-with-a-secret-at-least-32-chars-long

# External links
COMPETITION_CALENDAR_URL=https://cogitoacademy.id/en/calendar

# Environment
NODE_ENV=development

# Google OAuth (optional - leave blank to disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=