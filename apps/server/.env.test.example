# Dedicated env for automated tests. Copy to `.env.test` only if you need local overrides.
# Test PostgreSQL + Redis run via `bun run db:test` (docker-compose.test.yml, host port 6767).
DATABASE_URL=postgresql://postgres:password@localhost:6767/cogito-test

PORT=3101
WEB_PORT=3100

BETTER_AUTH_SECRET=test-secret-at-least-32-characters-long-1234
BETTER_AUTH_URL=http://localhost:3101
CORS_ORIGIN=http://localhost:3100
VITE_SERVER_URL=http://localhost:3101

PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=test-payment-webhook-secret-1234567890

NODE_ENV=test
