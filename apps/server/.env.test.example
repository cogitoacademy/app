# Dedicated env for automated tests. Copy to `.env.test` only if you need local overrides.
# Test PostgreSQL + Redis run via `bun run db:test` (docker-compose.test.yml, host port 6767/6379).
DATABASE_URL=postgresql://postgres:password@localhost:6767/cogito-test
REDIS_URL=redis://localhost:6379

PORT=3101
WEB_PORT=3100

BETTER_AUTH_SECRET=test-secret-at-least-32-characters-long-1234
BETTER_AUTH_URL=http://localhost:3101
CORS_ORIGIN=http://localhost:3100
VITE_SERVER_URL=http://localhost:3101

PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=test-payment-webhook-secret-1234567890

NODE_ENV=test

# Automated tests must never touch the live Google Calendar. Keep Meet
# disabled here; Playwright also forces these off at runtime so leaked CI
# credentials cannot create/cancel real events for seed attendees.
GOOGLE_MEET_ENABLED=false
GOOGLE_MEET_REFRESH_TOKEN=
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATED_USER=
