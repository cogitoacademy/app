# Dedicated T03 payout acceptance environment. Copy to `.env.test.payout` only
# after the parent assigns the isolated database/browser verification window.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:6770/cogito-test-payout
REDIS_URL=redis://127.0.0.1:6382

PORT=3111
WEB_PORT=3110
SERVER_URL=http://localhost:3111
WEB_URL=http://localhost:3110
BETTER_AUTH_URL=http://localhost:3111
CORS_ORIGIN=http://localhost:3110
VITE_SERVER_URL=http://localhost:3111

BETTER_AUTH_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
NODE_ENV=test

# Providers stay disabled/fake in this target; no live Calendar, bank, or email.
GOOGLE_MEET_ENABLED=false
GOOGLE_MEET_REFRESH_TOKEN=
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATED_USER=
