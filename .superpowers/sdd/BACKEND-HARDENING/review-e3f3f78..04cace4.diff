+  let latenessTicketId: string;
+  let technicalTicketId: string;
+
+  beforeAll(async () => {
+    const studentRes = await signUpAndSignIn(
+      studentEmail,
+      "Test1234!",
+      "Student Support",
+    );
+    studentClient = createTestClient(
