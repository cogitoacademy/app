index 267dd7b..d751ba3 100644
--- a/apps/server/.env.example
+++ b/apps/server/.env.example
@@ -8,20 +8,51 @@ PORT=3001
 BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-chars-long
 BETTER_AUTH_URL=http://localhost:3001
 
 # CORS (frontend URL)
 CORS_ORIGIN=http://localhost:3000
 
 # Payment
 PAYMENT_PROVIDER=stub
 PAYMENT_WEBHOOK_SECRET=replace-with-a-secret-at-least-32-chars-long
 
+# Webhooks
+# Comma-separated IP allowlist for payment webhooks (e.g. 1.2.3.4,5.6.7.8). Leave
+# empty to allow webhooks from any IP.
+WEBHOOK_ALLOWED_IPS=
+# Allow the authless stub checkout route (dev/test only; requires NODE_ENV != production).
+STUB_WEBHOOK_ALLOWED=false
+# Trust X-Forwarded-For for client IPs (set true only when behind a trusted reverse proxy).
+TRUST_PROXY=false
+
+# Seeding
+# Allow running the seed script in production (dangerous - keep false in prod).
+SEED_ALLOWED_IN_PROD=false
+# Admin password used by the seed script (min 12 chars).
+SEED_ADMIN_PASSWORD=
+
+# Redis (BullMQ queues, rate limits, idempotency)
+REDIS_URL=redis://localhost:6379
+
+# File uploads (Cloudflare R2)
+# When all R2_* credentials are set, uploads use R2; otherwise a local uploads
+# directory (UPLOAD_DIR) is used and served from /uploads/*.
+R2_ACCOUNT_ID=
+R2_ACCESS_KEY_ID=
+R2_SECRET_ACCESS_KEY=
+R2_BUCKET=
+# Optional: public base URL for R2 objects (e.g. https://cdn.example.com). When
+# unset, files are served through the app's /uploads/* route instead.
+R2_PUBLIC_URL=
+# Local upload directory (used when R2 is not configured).
+UPLOAD_DIR=./uploads
+
 # External links
 COMPETITION_CALENDAR_URL=https://cogitoacademy.id/en/calendar
 
 # Environment
 NODE_ENV=development
 
 # Google OAuth (optional - leave blank to disable Google login)
 GOOGLE_CLIENT_ID=
 GOOGLE_CLIENT_SECRET=
 
