{
  "name": "cogito-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "elysia": "^1.4.28",
      "@orpc/server": "^1.13.14",
      "@orpc/openapi": "^1.13.14",
      "@orpc/zod": "^1.13.14",
      "better-auth": "1.6.11",
      "next-themes": "^0.4.6",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "@orpc/client": "^1.13.14",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "drizzle-orm": "^0.45.1",
      "@types/pg": "^8.16.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @cogito-app/db db:push",
    "db:studio": "turbo -F @cogito-app/db db:studio",
    "db:generate": "turbo -F @cogito-app/db db:generate",
    "db:migrate": "turbo -F @cogito-app/db db:migrate",
    "db:start": "turbo -F @cogito-app/db db:start",
    "db:test": "turbo -F @cogito-app/db db:test",
    "db:watch": "turbo -F @cogito-app/db db:watch",
    "db:stop": "turbo -F @cogito-app/db db:stop",
    "db:down": "turbo -F @cogito-app/db db:down",
    "seed-packages": "bun --env-file apps/server/.env apps/server/src/seed-packages.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "check": "oxlint && oxfmt --write",
    "test": "bun test",
    "test:api": "bun test --env-file apps/server/.env packages/api/src/tests",
    "test:e2e": "turbo -F @cogito-app/e2e test",
    "test:e2e:ui": "turbo -F @cogito-app/e2e test:ui",
    "test:coverage": "bun test --coverage --env-file apps/server/.env packages/api/src/tests",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@cogito-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cogito-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.61.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
