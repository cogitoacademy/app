{
  "name": "cogito-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "elysia": "^1.4.28",
      "@orpc/server": "^1.13.14",
      "@orpc/openapi": "^1.13.14",
      "@orpc/zod": "^1.13.14",
      "better-auth": "1.6.11",
      "next-themes": "^0.4.6",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "@orpc/client": "^1.13.14",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "drizzle-orm": "^0.45.1",
      "@types/pg": "^8.16.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:server": "turbo run build --filter=server",
    "build:web": "turbo run build --filter=web",
    "check-types": "turbo run check-types --concurrency=1",
    "dev:web": "turbo run dev --filter=web",
    "dev:server": "turbo run dev --filter=server",
    "db:push": "turbo run db:push --filter=@cogito-app/db",
    "db:studio": "turbo run db:studio --filter=@cogito-app/db",
    "db:generate": "turbo run db:generate --filter=@cogito-app/db",
    "db:migrate": "turbo run db:migrate --filter=@cogito-app/db",
    "db:start": "turbo run db:start --filter=@cogito-app/db",
    "db:test": "turbo run db:test --filter=@cogito-app/db",
    "db:watch": "turbo run db:watch --filter=@cogito-app/db",
    "db:stop": "turbo run db:stop --filter=@cogito-app/db",
    "db:down": "turbo run db:down --filter=@cogito-app/db",
    "seed-packages": "bun --env-file apps/server/.env apps/server/src/seed/seed-packages.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "check": "oxlint && oxfmt --write",
    "test": "bun test",
    "test:api": "bun test --timeout 30000 --env-file apps/server/.env.test packages/api/src/tests",
    "test:e2e": "turbo run test --filter=@cogito-app/e2e",
    "test:e2e:ui": "turbo run test:ui --filter=@cogito-app/e2e",
    "test:coverage": "bun --env-file apps/server/.env.test .github/scripts/coverage-runner.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@cogito-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cogito-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-instrument": "1.7.8",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-reports": "3.0.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "lefthook": "^2.1.9",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "turbo": "^2.10.9",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
