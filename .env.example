# Database
DATABASE_URL=postgres://user:password@localhost:5432/cogito

# Auth
BETTER_AUTH_SECRET=change-me-to-a-32-char-secret-minimum
BETTER_AUTH_URL=http://localhost:3001

# CORS
CORS_ORIGIN=http://localhost:3000

# Environment
NODE_ENV=development

# Payment
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=change-me-to-a-32-char-secret-minimum

# Xendit (required if PAYMENT_PROVIDER=xendit)
# XENDIT_SECRET_KEY=
# XENDIT_WEBHOOK_TOKEN=
# XENDIT_SUCCESS_REDIRECT_URL=
# XENDIT_FAILURE_REDIRECT_URL=
# XENDIT_DEFAULT_PAYMENT_METHOD=ewallet_ovo

# Server
PORT=3001

# Session
SESSION_COOKIE_CACHE_MAX_AGE=60

# Redis (optional)
# REDIS_URL=redis://localhost:6379

# Scheduler
SCHEDULER_ENABLED=false

# Google Calendar / Meet (optional)
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_CALENDAR_ID=primary
GOOGLE_MEET_ENABLED=false

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email
# RESEND_API_KEY=
EMAIL_FROM=noreply@cogitoacademy.id

# Metrics (optional)
# METRICS_TOKEN=

# Database SSL
DB_SSL_REJECT_UNAUTHORIZED=true

# Competition Calendar URL
COMPETITION_CALENDAR_URL=https://cogitoacademy.id/en/calendar